<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">

    <!-- Configuración para copias de seguridad en Google Drive (Nube) -->
    <cloud-backup>

        <!-- Excluimos la base de datos y los archivos de claves -->
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="keyset_shared_preferences.xml"/>
        <exclude domain="file" path="sec_db_key.enc" />

        <!-- Excluimos cachés y archivos temporales para ahorrar espacio -->
        <exclude domain="external" path="."
            tools:ignore="FullBackupContent" />
        <exclude domain="root" path="cache"
            tools:ignore="FullBackupContent" />

    </cloud-backup>

    <!-- Configuración para transferencia directa entre dispositivos (Cable o Wi-Fi) -->
    <device-transfer>

        <!-- Excluimos la base de datos y los archivos de claves -->
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="keyset_shared_preferences.xml"/>
        <exclude domain="file" path="sec_db_key.enc" />

    </device-transfer>

</data-extraction-rules>