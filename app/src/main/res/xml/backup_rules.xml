<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">

    <!-- Excluimos la base de datos y los archivos de claves -->
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="keyset_shared_preferences.xml"/>
    <exclude domain="file" path="sec_db_key.enc" />

    <!-- Excluye cachés -->
    <exclude domain="root" path="cache"
        tools:ignore="FullBackupContent" />

</full-backup-content>